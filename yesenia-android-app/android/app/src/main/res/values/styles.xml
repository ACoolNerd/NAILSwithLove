        <item name="colorPrimary">#7A2036</item>
        <item name="colorPrimaryVariant">#3A1420</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">#C9A227</item>
